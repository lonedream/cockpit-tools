{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XM",
  "version": "0.25.6",
  "identifier": "xin.xingmeng.xm",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri.cjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-tauri.cjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "XM",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true
      },
      {
        "label": "floating-card",
        "title": "XM",
        "create": false,
        "width": 250,
        "height": 290,
        "minWidth": 250,
        "minHeight": 290,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "../sidecars/cockpit-cliproxy/bin/xm-cliproxy"
    ],
    "icon": [
      "icons/48x48.png",
      "icons/32x32.png",
      "icons/16x16.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/assets/icons/antigravity-menu.png": "native-menu-icons/antigravity-menu.png",
      "../src/assets/icons/codebuddy.png": "native-menu-icons/codebuddy.png",
      "../src/assets/icons/codex.svg": "native-menu-icons/codex.svg",
      "../src/assets/icons/cursor-menu.png": "native-menu-icons/cursor-menu.png",
      "../src/assets/icons/gemini-menu.png": "native-menu-icons/gemini-menu.png",
      "../src/assets/icons/github-copilot.svg": "native-menu-icons/github-copilot.svg",
      "../src/assets/icons/kiro-menu.png": "native-menu-icons/kiro-menu.png",
      "../src/assets/icons/qoder.png": "native-menu-icons/qoder.png",
      "../src/assets/icons/trae.png": "native-menu-icons/trae.png",
      "../src/assets/icons/windsurf.svg": "native-menu-icons/windsurf.svg",
      "../src/assets/icons/workbuddy.png": "native-menu-icons/workbuddy.png",
      "../src/assets/icons/zed.png": "native-menu-icons/zed.png"
    },
    "macOS": {
      "bundleName": "XM",
      "infoPlist": "Info.plist"
    },
    "publisher": "Xingmeng",
    "shortDescription": "XM desktop client",
    "longDescription": "XM desktop client for model account and API relay workflows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "XM"
      },
      "wix": {
        "upgradeCode": "7f2c66e7-0d33-55c3-97f0-31dfc2ad8f30"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "xm",
          "xmtools"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MjAxODRCQTVFNTg5OTAKUldTUWllV2xTeGdnUmxMQkxxTjFHK0szUzlacVZZUjRqMW1xemxwbFJMK0U1VlFkdGZCeU9jWjAK",
      "endpoints": [
        "https://github.com/lonedream/cockpit-tools/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "xm"
}
